# ============================================================================
# HRM backend — server secrets (TEMPLATE)
#
# On the server:   cp .env.example .env && chmod 600 .env && nano .env
#
# .env is never committed and never stored in GitHub. It is read by the API
# container only. The admin panel has no runtime secrets.
#
# Non-secret settings (ports, domains, image tags, memory) live in config.sh.
# ============================================================================

NODE_ENV=production
HOST=0.0.0.0
PORT=5004

# ---- Database: this project's own role + database on the shared RDS Postgres ---
# sslmode=no-verify is required: the backend's `pg` pool lets the URL override its
# own ssl setting, and plain `require` would reject the RDS certificate.
DATABASE_URL=postgresql://hrm_user:CHANGE_ME@main-postgresql.cxsmy4qm2seg.ap-southeast-2.rds.amazonaws.com:5432/hrm?sslmode=no-verify

# ---- Auth — REQUIRED (the code has hard-coded fallbacks, so start-api.sh refuses to run without JWT_SECRET)
# Generate:  openssl rand -base64 32
JWT_SECRET=
REFRESH_SECRET=
# JWT_EXPIRES_IN=24h

# ---- Optional integrations -----------------------------------------------------
# GOOGLE_MAPS_API_KEY=

# Firebase push notifications — EITHER put the service-account JSON file at
# secrets/firebase-service-account.json (mounted read-only into the container),
# OR set these variables:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}   (one line)
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_CLIENT_ID=
# FIREBASE_PRIVATE_KEY=
